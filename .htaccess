Options -Indexes
RewriteEngine On

# HTTPS / Mixed-Content-Schutz + Sicherheits-Header
<IfModule mod_headers.c>
  # Unsichere http://-Subressourcen automatisch auf https:// hochstufen + Clickjacking-Schutz
  Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # HSTS nur über HTTPS senden (erzwingt künftige Aufrufe über https)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# Sensible Dateitypen nie ausliefern (Datenbank, Logs, Konfig, Backups)
<FilesMatch "\.(db|sqlite|sqlite3|log|env|ini|sh|md|lock|json)$">
  Require all denied
</FilesMatch>
# package.json wird nicht benötigt; .well-known bleibt erreichbar (s. unten)

# Datenbank und lib schützen
RewriteRule ^data/        - [F,L]
RewriteRule ^lib/         - [F,L]
RewriteRule ^partials/    - [F,L]
RewriteRule ^src/         - [F,L]

# Existierende Dateien direkt ausliefern; Verzeichnisse NUR wenn nicht /admin
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !^/admin
RewriteRule ^ - [L]

# Statische Assets aus public/ ausliefern
RewriteRule ^css/(.+)$      /public/css/$1     [L]
RewriteRule ^js/(.+)$       /public/js/$1      [L]
RewriteRule ^img/(.+)$      /public/img/$1     [L]
RewriteRule ^assets/(.+)$   /public/assets/$1  [L]
RewriteRule ^uploads/(.+)$  /public/uploads/$1 [L]

# Saubere URLs ohne .php
RewriteRule ^shop$              /shop.php         [L,QSA]
RewriteRule ^warenkorb$         /warenkorb.php    [L,QSA]
RewriteRule ^kasse$             /kasse.php        [L,QSA]
RewriteRule ^kontakt$           /kontakt.php      [L,QSA]
RewriteRule ^wunschliste$       /wunschliste.php  [L,QSA]
RewriteRule ^newsletter$        /newsletter.php   [L,QSA]
RewriteRule ^anmelden$          /anmelden.php     [L,QSA]
RewriteRule ^registrieren$      /registrieren.php [L,QSA]
RewriteRule ^konto$             /konto.php        [L,QSA]
RewriteRule ^anfrage$           /anfrage.php      [L,QSA]
RewriteRule ^abmelden$          /abmelden.php     [L,QSA]

# Dynamische Routen
RewriteRule ^produkt/([^/]+)/?$          /produkt.php?slug=$1          [L,QSA]
RewriteRule ^bestellung$                 /bestellung.php               [L,QSA]
RewriteRule ^bestellung/([^/]+)/?$       /bestellung.php?ref=$1        [L,QSA]

# Warenkorb-API
RewriteRule ^warenkorb/api/add$     /api/cart-add.php    [L,QSA]
RewriteRule ^warenkorb/api/state$   /api/cart-state.php  [L,QSA]
RewriteRule ^warenkorb/api/update$  /api/cart-update.php [L,QSA]

# Checkout API
RewriteRule ^api/checkout$           /api/checkout.php          [L,QSA]

# Shop-API
RewriteRule ^api/produkte$           /api/produkte.php          [L,QSA]
RewriteRule ^api/review$             /api/review.php            [L,QSA]
RewriteRule ^api/discount-check$     /api/discount-check.php    [L,QSA]

# Admin-API
RewriteRule ^admin/api/products/(\d+)$         /admin/api/products.php?id=$1  [L,QSA]
RewriteRule ^admin/api/products$               /admin/api/products.php        [L,QSA]
RewriteRule ^admin/api/upload$                 /admin/api/upload.php          [L,QSA]
RewriteRule ^admin/api/inventory-save$         /admin/api/inventory-save.php  [L,QSA]
RewriteRule ^admin/api/stock-adjust$           /admin/api/stock-adjust.php    [L,QSA]

# Admin ohne .php
RewriteRule ^admin/?$                          /admin/index.php            [L,QSA]
RewriteRule ^admin/login$                      /admin/login.php            [L,QSA]
RewriteRule ^admin/logout$                     /admin/logout.php           [L,QSA]
RewriteRule ^admin/produkte$                   /admin/produkte.php         [L,QSA]
RewriteRule ^admin/bestellungen$               /admin/bestellungen.php     [L,QSA]
RewriteRule ^admin/lager$                      /admin/lager.php            [L,QSA]
RewriteRule ^admin/nachrichten$                /admin/nachrichten.php      [L,QSA]
RewriteRule ^admin/newsletter$                 /admin/newsletter.php       [L,QSA]
RewriteRule ^admin/einstellungen$              /admin/einstellungen.php    [L,QSA]
RewriteRule ^admin/sicherheit$                 /admin/sicherheit.php       [L,QSA]
RewriteRule ^admin/rabatte$                    /admin/rabatte.php          [L,QSA]
RewriteRule ^admin/analytics$                  /admin/analytics.php        [L,QSA]
RewriteRule ^admin/preisrechner$               /admin/preisrechner.php     [L,QSA]
RewriteRule ^admin/finanzen$                   /admin/finanzen.php         [L,QSA]
RewriteRule ^admin/bewertungen$                /admin/bewertungen.php      [L,QSA]
RewriteRule ^admin/kunden$                     /admin/kunden.php           [L,QSA]
RewriteRule ^admin/produkt/([0-9]+)/?$         /admin/produkt-edit.php?id=$1  [L,QSA]
RewriteRule ^admin/produkt/neu$                /admin/produkt-edit.php     [L,QSA]
RewriteRule ^admin/bestellung/([^/]+)/?$       /admin/bestellung.php?ref=$1   [L,QSA]
RewriteRule ^admin/lager/([0-9]+)/?$           /admin/lager-edit.php?id=$1    [L,QSA]

# 404-Handler
ErrorDocument 404 /404.php
